{
  "rules": [
    {
      "allowed": {
        "origins": ["https://cutmoor.com", "https://www.cutmoor.com"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
