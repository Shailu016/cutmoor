# Public site URL. No trailing slash. Used for canonical URLs, sitemap, JSON-LD.
# Leave empty until https://cutmoor.com is connected: the build then uses the
# host's own URL (Cloudflare Pages, Netlify, Vercel), never an unowned domain.
VITE_SITE_URL=

# Where the browser loads the ffmpeg core from. Empty = same origin (/ffmpeg).
# Required on Cloudflare Pages (25 MiB per-file limit; the wasm is ~31 MiB).
# Run `R2_BUCKET=<bucket> npm run upload:ffmpeg`, then paste the URL it prints:
# VITE_FFMPEG_BASE_URL=https://assets.cutmoor.com/ffmpeg/0.12.10
VITE_FFMPEG_BASE_URL=

# Google AdSense. Leave the client empty to disable ads entirely (recommended
# until the site is approved and a certified CMP is configured for the EEA/UK).
# Example client: ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_ARTICLE=
VITE_ADSENSE_SLOT_FOOTER=
