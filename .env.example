# Public site URL. No trailing slash. Used for canonical URLs, sitemap, JSON-LD.
# Defaults to the planned launch origin, https://cutmoor.com. Until that domain
# is purchased and connected, set this to the actual deployment URL (for example
# https://cutmoor.netlify.app) so canonical URLs do not point at a domain you do
# not control.
VITE_SITE_URL=https://cutmoor.com

# Google AdSense. Leave the client empty to disable ads entirely (recommended
# until the site is approved and a certified CMP is configured for the EEA/UK).
# Example client: ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_ARTICLE=
VITE_ADSENSE_SLOT_FOOTER=
