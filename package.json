{
  "name": "cutmoor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cutmoor — the browser video and image toolkit. Compress, crop, trim, convert, extract audio, resize images, and convert HEIC to JPG without uploading.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/finalize-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm test && npm run build",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "upload:ffmpeg": "node scripts/upload-ffmpeg.mjs",
    "new:guide": "node scripts/new-guide.mjs",
    "budget": "node scripts/check-budget.mjs",
    "models:build": "node scripts/models/build-manifest.mjs",
    "models:verify": "node scripts/models/verify-manifest.mjs",
    "models:upload": "node scripts/models/upload-r2.mjs",
    "verify:captions": "node scripts/verify/captions-network.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@mediabunny/aac-encoder": "1.66.0",
    "heic-to": "^1.6.7",
    "lucide-react": "^0.577.0",
    "mediabunny": "1.66.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
